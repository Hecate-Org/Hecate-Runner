# Private systemd environment for the writer role. Install with mode 0600.
# Copy required non-secret configuration from the current workspace.
HECATE_RUNNER_QUERY_PROVIDER=splunk
SPLUNK_HOST=https://localhost:8089
SPLUNK_VERIFY_SSL=true
SPLUNK_READ_TOKEN=
SPLUNK_WRITE_TOKEN=
# See docs/SERVICE_ISOLATION.md for role scope and publishing key paths.
