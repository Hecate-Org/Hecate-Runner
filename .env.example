# -----------------------------------------------------------------------------
# hecate-runner configuration
#
# Copy this file to .env and edit for your environment.
# All credential stubs are synthetic and commented out. Uncomment and replace
# only the values required by the features you enable, in your ignored .env.
# Prefer $HECATE_WORKSPACE/.env as the shared configuration for both CLIs.
# A Runner-local .env is an optional override; avoid conflicting copies.
# Existing process environment variables take precedence over dotenv settings.
# Generation needs a model and CTI input; web search needs a Tavily key.
# Existing-hunt execution needs a model and a configured SIEM, without generation.
# Unrelated API subscriptions, Slack, publishing and live BAS are optional.
# -----------------------------------------------------------------------------

# --- Hecate workspace ---------------------------------------------------------
# Absolute path to your hunt workspace (for example, your Hecate-Public clone).
# Without an explicit path, discovery uses a nearby workspace config or cwd.
# HECATE_WORKSPACE=/absolute/path/to/Hecate-Public
# Export HECATE_WORKSPACE in your shell before launching from another directory.

# Path to the hecate-agent CLI binary. If empty, defaults to $HECATE_WORKSPACE/.venv/bin/hecate-agent
# HECATE_BIN=/absolute/path/to/Hecate-Core/.venv/bin/hecate-agent
# Compact workspace hunting guidance is on by default; the full reference is not injected.
# HECATE_HUNTING_KNOWLEDGE=true

# --- Model provider: required for agentic features ------------------------------
# Uncomment the provider/model lines and ONE matching credential below.
# Use a model ID available to your account or installed on your local server.
# Provider values: openai, litellm, bedrock, ollama. Set them explicitly to avoid
# selecting a different backend when several credentials are present.
#
# OpenAI or an OpenAI-compatible server:
# HECATE_LLM_PROVIDER=openai
# HECATE_LLM_MODEL=replace-with-your-model-id
# OPENAI_API_KEY=replace-with-your-api-key
# HECATE_LLM_BASE_URL=https://api.openai.com/v1
# For another compatible server, replace BASE_URL and supply its credential.
#
# Other choices: change PROVIDER/MODEL above; only uncomment matching credentials.
# Anthropic: PROVIDER=litellm; MODEL=anthropic/your-model-id
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Gemini: PROVIDER=litellm; MODEL=gemini/your-model-id
# GOOGLE_API_KEY=replace-with-your-google-api-key
# Bedrock: PROVIDER=bedrock; MODEL=your-bedrock-model-or-inference-profile-id
# Prefer an AWS profile or the host's IAM role; keys below are an alternative.
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
# AWS_SESSION_TOKEN=replace-with-your-temporary-session-token
# Ollama: PROVIDER=ollama; MODEL=your-installed-model-tag; no API key required.
# Set BASE_URL above to http://localhost:11434, or use OLLAMA_HOST instead.
# OLLAMA_HOST=http://localhost:11434
# HECATE_OLLAMA_TIMEOUT_SEC=180
# HECATE_OLLAMA_NUM_CTX=16384
# HECATE_OLLAMA_THINK=false

# Optional separate models for routine work and reasoning. Leave all unset for
# a single model. Each tier inherits unset values from the root configuration;
# supply that tier's BASE_URL too when switching to another backend.
# HECATE_LLM_SIMPLE_PROVIDER=ollama
# HECATE_LLM_SIMPLE_MODEL=your-installed-model-tag
# HECATE_LLM_SIMPLE_BASE_URL=http://localhost:11434
# Soft clip for simple-tier prompts (chars). Keep under HECATE_OLLAMA_NUM_CTX headroom.
# HECATE_LLM_SIMPLE_MAX_PROMPT_CHARS=12000
# HECATE_LLM_COMPLEX_PROVIDER=openai
# HECATE_LLM_COMPLEX_MODEL=replace-with-your-reasoning-model-id
# HECATE_LLM_COMPLEX_BASE_URL=https://api.openai.com/v1
# Demote locked capabilities only after Core eval writes a gate stamp, then set
# llm.defaults.<capability>: simple in the workspace .hecateconfig.yaml.
# HECATE_LLM_DEMOTION_GATES=/path/to/llm_demotion_gates.json
# Lab-only unlock (skips eval gates): HECATE_LLM_ALLOW_DEMOTION=1

# --- Optional research web search ---------------------------------------------
# Needed for Tavily-backed web search, not for executing existing hunt queries.
# TAVILY_API_KEY=replace-with-your-tavily-api-key

# --- Sigma detection drafting -------------------------------------------------
# Draft Sigma rules for every log source a hunt applies to, after the
# hypothesis and before any human sees the draft, so an operator reviews a
# hunt that already has candidate detection logic instead of an empty
# "Hunting Queries" section.
#
# Sigma rather than SPL/KQL because the program has no committed query
# platform: `sigma convert -t <backend>` retargets these to Splunk, Elastic,
# CrowdStrike or Defender later, so drafting now commits to nothing.
#
# These are PROPOSALS. Nothing here is executed, and the review gate is
# unchanged -- the draft still cannot advance past `planning` without a human.
# A drafting failure leaves the hunt standing with its placeholder query
# section, so turning this off only removes the section.
# HECATE_RUNNER_SIGMA_GENERATION_ENABLED=true

# Timeout for the whole Sigma drafting subprocess. Drafting makes one LLM
# call per applicable log source (up to six), so the worst case is six model
# timeouts back to back. Each individual call is bounded by
# HECATE_OLLAMA_TIMEOUT_SEC in the workspace .env.
# HECATE_RUNNER_SIGMA_TIMEOUT_SEC=1800

# --- Logging ------------------------------------------------------------------
# Rotate the orchestrator log once it passes this size, checked at the start of
# every run. 0 disables rotation. Rotation copies the file aside and truncates
# it in place rather than renaming it: the systemd unit also holds this file
# open (StandardOutput=append:), and a rename would leave systemd writing to
# the archive for the rest of the run while Python wrote to the new file.
# HECATE_RUNNER_LOG_MAX_BYTES=5242880
# HECATE_RUNNER_LOG_BACKUP_COUNT=5

# --- Orchestrator behavior --------------------------------------------------
# Max draft hunts the orchestrator will create per UTC day. Guardrail.
HECATE_RUNNER_MAX_DRAFTS_PER_DAY=4

# Maximum research runs per UTC day. Failed attempts still consume quota.
HECATE_RUNNER_MAX_RESEARCH_RUNS_PER_DAY=7
# HECATE_RUNNER_DAILY_BUDGET_USD=20
# HECATE_RUNNER_MIN_HOURS_BETWEEN_DRAFTS=6
# HECATE_RUNNER_DAEMON_INTERVAL_SEC=60

# Hard timeout in seconds on any hecate subprocess call (research or hypothesis
# each get their own budget — this is per-call, not a shared total).
# Primary-source fetching, extraction and indicator classification share one
# budget of this length; a timeout kills their worker and falls back to feed text.
HECATE_RUNNER_LLM_TIMEOUT_SEC=600

# Shared budget for primary-source extraction, recovery and classification.
# Token reservations conservatively count UTF-8 prompt bytes plus capped output;
# they are separate from provider-reported/billed tokens. Cache hits spend neither.
HECATE_RUNNER_SOURCE_EVIDENCE_MAX_CALLS=16
HECATE_RUNNER_SOURCE_EVIDENCE_MAX_TOKENS=256000
# Re-fetch source content before reuse. Cache verified replies for at most a day
# in the workspace's .hecate/source_evidence.db (at most 512 entries).
HECATE_RUNNER_SOURCE_EVIDENCE_CACHE_ENABLED=true
HECATE_RUNNER_SOURCE_EVIDENCE_CACHE_TTL_SEC=86400

# Run the research stage before hypothesis generation. Failures leave CTI queued
# for retry. Disabling this stage does not disable primary-source extraction.
HECATE_RUNNER_RESEARCH_ENABLED=true
# basic or advanced; subprocess timeout above must accommodate the selected depth.
HECATE_RUNNER_RESEARCH_DEPTH=basic

# CTI provider used by `hecate-runner run`. "file" (default) reads cti_queue/next.txt;
# "otx" pulls directly from AlienVault OTX; "rss" pulls directly from the
# configured RSS feeds; "misp" pulls from a MISP instance. "multi" fans out
# across several of these at once (see HECATE_RUNNER_CTI_MULTI_PROVIDERS below) —
# each cycle round-robins which source gets first pick, so RSS's ten feeds
# can't crowd out a slower source like MISP.
HECATE_RUNNER_CTI_PROVIDER=file

# Sub-providers to combine when HECATE_RUNNER_CTI_PROVIDER=multi, comma-separated,
# for example: file, otx, rss, misp. Each needs its own inputs configured
# (e.g. "rss,otx,misp" needs OTX_API_KEY and MISP_BASE_URL/MISP_API_KEY set,
# in addition to RSS's feed list, which has a working default).
# HECATE_RUNNER_CTI_MULTI_PROVIDERS=rss,otx,misp

# Hold back CTI that is commentary rather than intelligence -- a conference
# recap, a weekly news roundup, a vendor product post. Three of the first
# fifteen drafts came from source material like that.
#
# "park" (default) never discards: the item is written whole to
# <cti_queue>/parked/ with the reason attached. List them with
# `hecate-runner parked list` and put one back with `hecate-runner parked
# restore <id>`. That recoverability is the point -- a dropped item would be
# invisible and permanent, since the provider cursor has already moved past it.
#
# "off" drafts from everything, the behaviour before this existed.
#HECATE_RUNNER_CTI_TRIAGE=park

# Log level — DEBUG, INFO, WARNING, ERROR
HECATE_RUNNER_LOG_LEVEL=INFO

# --- CTI provider: file (default) -------------------------------------------
# Directory holding the CTI intake queue. Defaults to $HECATE_WORKSPACE/cti_queue
# HECATE_RUNNER_CTI_QUEUE_DIR=

# --- Query execution: configure ONE backend -----------------------------------
# mock is offline. For live queries, change this to splunk, sentinel, elastic,
# or crowdstrike, and uncomment that backend's endpoint and credentials below.
HECATE_RUNNER_QUERY_PROVIDER=mock
HECATE_RUNNER_MAX_QUERY_TIME_RANGE_DAYS=7
HECATE_RUNNER_MAX_QUERY_LIMIT=1000

# Splunk management host (not the web UI); token must permit search.
# SPLUNK_HOST=splunk.example
# SPLUNK_TOKEN=replace-with-your-splunk-search-token
# SPLUNK_VERIFY_SSL=true
# Optional basic authentication instead of SPLUNK_TOKEN:
# SPLUNK_USERNAME=replace-with-your-splunk-username
# SPLUNK_PASSWORD=replace-with-your-splunk-password

# Microsoft Sentinel: Log Analytics workspace GUID and Logs API bearer token.
# This adapter takes an existing token; renew it before it expires.
# SENTINEL_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# SENTINEL_BEARER_TOKEN=replace-with-your-azure-logs-access-token
# AZURE_ACCESS_TOKEN is also accepted; use one token variable.

# Elasticsearch EQL endpoint (not Kibana); index must contain compatible events.
# ELASTIC_URL=https://elasticsearch.example:9200
# ELASTIC_API_KEY=replace-with-your-elasticsearch-api-key
# ELASTIC_INDEX=logs-endpoint-*
# ELASTIC_TIMESTAMP_FIELD=@timestamp

# CrowdStrike LogScale: instance URL, repository and read token.
# FALCON_LOGSCALE_URL=https://logscale.example
# FALCON_LOGSCALE_REPO=replace-with-your-logscale-repository
# FALCON_LOGSCALE_TOKEN=replace-with-your-logscale-read-token

# --- Agentic hunting using existing H files (no generation required) ------------
# Run `hecate-runner sweep list` to inspect eligible hunts. Scheduled sweeps use
# active hunts with query files matching the chosen backend; review status and
# queries before enabling. Start the worker with `hecate-runner sweep daemon`.
# Enable execution only after configuring the model, SIEM and approval workflow.
# With approval required, staged executions need approval before live queries run.
HECATE_AUTO_HUNT_EXECUTION_ENABLED=false
HECATE_AUTO_HUNT_APPROVAL_REQUIRED=true
# HECATE_AUTO_HUNT_MAX_FETCH=200
# HECATE_AUTO_HUNT_CADENCE_HOURS=24
# HECATE_AUTO_HUNT_DEFAULT_LOOKBACK_DAYS=1
# HECATE_AUTO_HUNT_SWEEP_INTERVAL_SEC=3600
# HECATE_AUTO_HUNT_PIVOTS_ENABLED=true
# HECATE_AUTO_HUNT_MAX_PIVOTS=3
# HECATE_AUTO_HUNT_PIVOT_MIN_CONFIDENCE=0.7
# HECATE_HUNT_EXECUTIONS_DB=/absolute/path/to/workspace/.hecate/hunt_executions.db

# --- Optional Slack notifications and interactive approvals --------------------
# Notification options: a webhook for its configured channel, or a bot token
# for channel routing. Invite the bot to the channels it will use.
# HECATE_RUNNER_SLACK_WEBHOOK_URL=https://hooks.slack.example/services/replace-with-your-webhook-path
# SLACK_BOT_TOKEN=replace-with-your-slack-bot-token
# Socket Mode interaction additionally needs an app token and the flag below.
# Configure the Slack app and run `hecate-runner slack-bot` as described in Runner docs.
# SLACK_APP_TOKEN=replace-with-your-slack-app-token
HECATE_RUNNER_SLACK_INTERACTIVE_ENABLED=false
# Use channel IDs from your workspace, not these descriptive placeholders.
# If using a channel name beginning with #, quote it so dotenv preserves it.
# SLACK_CHANNEL_OPS_METRICS=replace-with-ops-metrics-channel-id
# SLACK_CHANNEL_HUNTS_EXEC=replace-with-hunt-executive-channel-id
# SLACK_CHANNEL_PURPLE_TEAM=replace-with-purple-team-channel-id
# SLACK_CHANNEL_EXPLOITS=replace-with-exploits-channel-id
# SLACK_CHANNEL_SANDBOX=replace-with-sandbox-channel-id
# SLACK_CHANNEL_APT=replace-with-apt-channel-id
# SLACK_CHANNEL_CLOUD=replace-with-cloud-channel-id
# SLACK_CHANNEL_C2=replace-with-c2-channel-id
# SLACK_CHANNEL_DETECTION_ENGINEERING=replace-with-detection-engineering-channel-id
# SLACK_CHANNEL_THREAT_INTEL=replace-with-threat-intel-channel-id
# SLACK_CHANNEL_THREAT_HUNTING=replace-with-threat-hunting-channel-id

# --- Optional observable enrichment -------------------------------------------
# Enable only services you use; these keys are not all required to run Hecate.
# Missing keys skip credential-dependent enrichment. Public lookups may still run.
# GREYNOISE_API_KEY=replace-with-your-greynoise-api-key
# SHODAN_API_KEY=replace-with-your-shodan-api-key
# CENSYS_API_TOKEN=replace-with-your-censys-api-token
# CENSYS_ORGANIZATION_ID=replace-with-your-censys-organization-id
# ABUSECH_API_KEY=replace-with-your-abusech-api-key
# ABUSEIPDB_API_KEY=replace-with-your-abuseipdb-api-key
# VT_API_KEY=replace-with-your-virustotal-api-key
# URLSCAN_API_KEY=replace-with-your-urlscan-api-key
# OTX_API_KEY=replace-with-your-otx-api-key
# SPUR_API_KEY=replace-with-your-spur-api-key
# MNEMONIC_API_KEY=replace-with-your-mnemonic-api-key
# IPINFO_TOKEN=replace-with-your-ipinfo-token
# HYBRID_ANALYSIS_API_KEY=replace-with-your-hybrid-analysis-api-key
# TRIAGE_API_KEY=replace-with-your-triage-api-key
# VULNCHECK_API_KEY=replace-with-your-vulncheck-api-key
# SHADOWSERVER_API_KEY=replace-with-your-shadowserver-api-key
# SHADOWSERVER_API_SECRET=replace-with-your-shadowserver-api-secret

# MISP enrichment/intake: instance URL and read credential.
# MISP_BASE_URL=https://misp.example
# MISP_API_KEY=replace-with-your-misp-read-api-key
# MISP_VERIFY_SSL=true
# HECATE_RUNNER_MISP_VERIFY_SSL=true

# --- AlienVault OTX -----------------------------------------------------------
# Free-tier API key from https://otx.alienvault.com/settings — required both
# for HECATE_RUNNER_CTI_PROVIDER=otx and for `hecate-runner otx-poll` (a manual
# one-shot that stages a pulse into the file queue; there is no poller unit).

# Tuning knobs for the OTX provider/poller — defaults are usually fine.
# HECATE_RUNNER_OTX_BASE_URL=https://otx.alienvault.com
# HECATE_RUNNER_OTX_PAGE_LIMIT=20
# HECATE_RUNNER_OTX_MAX_PULSE_AGE_DAYS=30
# HECATE_RUNNER_OTX_REQUEST_TIMEOUT_SEC=30

# --- RSS/Atom CTI provider -----------------------------------------------------
# No API key required — comma-separated feed URLs. Defaults to four verified,
# reputable security research blogs (The DFIR Report, Talos, Unit42, Microsoft
# Security Blog); this is a curation choice, not a technical requirement, so
# swap freely. CISA's advisory feed was tried and excluded: it 403s on
# automated requests on every path tried, with or without a browser User-Agent.
# HECATE_RUNNER_RSS_FEED_URLS=https://thedfirreport.com/feed/,https://blog.talosintelligence.com/rss/,https://unit42.paloaltonetworks.com/feed/,https://www.microsoft.com/en-us/security/blog/feed/

# Ignore RSS entries older than this. Unlike OTX's TLP/ATT&CK-mapping filter,
# feed curation itself is the main "high signal" filter here — every URL in
# the list is hand-picked, not an open subscription firehose.
# HECATE_RUNNER_RSS_MAX_ENTRY_AGE_DAYS=30
# HECATE_RUNNER_RSS_REQUEST_TIMEOUT_SEC=30

# --- MISP CTI provider -----------------------------------------------------
# Base URL and Auth key for a MISP instance. Required for cti_provider=misp
# and `hecate-runner misp-poll`. Use a dedicated automation key (Administration ->
# List Auth Keys -> Add authentication key in the MISP UI), not a personal
# user's key.
# Store final pipeline output in MISP independently of MISP CTI intake.
HECATE_RUNNER_MISP_PUBLISHING_ENABLED=false
# Optional dedicated writer credential; leave MISP_API_KEY read-only for intake.
# MISP_OUTPUT_API_KEY=replace-with-your-misp-write-api-key

# Set to false only for self-signed dev/test instances (e.g. a local
# misp-docker deployment) -- keep true for any MISP with a real certificate.
# Only route events carrying a galaxy cluster. Galaxy presence separates a
# curated, analyst-written event from a bulk indicator dump -- dumps describe
# no behavior, so they can only ever produce indicator-sweep drafts with no
# ATT&CK mapping. Set false for an instance that does not tag galaxies at all,
# otherwise the provider will correctly find nothing to route.
# HECATE_RUNNER_MISP_REQUIRE_GALAXY=true

# Only route events that map to at least one ATT&CK technique. Stricter than
# REQUIRE_GALAXY, which any galaxy cluster satisfies: an event tagged only
# with a threat-actor or malware galaxy has a cluster but no attack-pattern,
# so it yields no technique IDs and can only ever become an indicator sweep.
# Off by default because a sweep is still useful output; turn it on to route
# only events a behavioural hunt can actually be built from.
# HECATE_RUNNER_MISP_REQUIRE_ATTACK_TECHNIQUE=false

# Comma-separated MISP organisation names; only events from these orgs are
# routable. Empty (the default) means every org is eligible. REQUIRE_GALAXY
# tells curated events from dumps, but it cannot tell a high-volume curated
# feed from the few analyst-written events beside it -- on the reference
# instance one org holds 856 of 872 routable events, enough to bury the rest
# for a year at any sane drafts-per-day. Matched case-insensitively against
# the authoring org (Orgc), so it still works on a synced instance.
# This RESTRICTS, it does not rank: excluded events are walked past for good,
# because the cursor advances over them. Widen the list before a backfill
# rather than after, or reseed the cursor to revisit what was skipped.
# HECATE_RUNNER_MISP_ORG_ALLOWLIST=

# Ignore events published before this many days ago.
# HECATE_RUNNER_MISP_MAX_EVENT_AGE_DAYS=30

# Drop the freshness floor above and walk the archive oldest-first, for an
# instance whose curated events predate it. Seed .misp_cursor_state.json to
# choose where the walk starts. The cursor advances each poll and converges
# back into normal behavior on reaching the present -- turn this off then,
# since with it on a lost cursor restarts from the beginning of the archive.
# HECATE_RUNNER_MISP_BACKFILL=false

# How many event pages one poll may walk before giving up. A run of rejected
# events longer than one page is normal on an instance carrying a daily dump
# feed; pages are fetched metadata-only, so the cost is small.
# HECATE_RUNNER_MISP_MAX_PAGES_PER_POLL=25
# HECATE_RUNNER_MISP_PAGE_LIMIT=20
# HECATE_RUNNER_MISP_REQUEST_TIMEOUT_SEC=30

# --- Additional CTI provider credentials ---------------------------------------
# Select only providers you intend to poll. Set CTI_PROVIDER to the provider name,
# or CTI_PROVIDER=multi and list names in CTI_MULTI_PROVIDERS (without "multi").
# github_poc / vxunderground: optional GitHub intake token, separate from publishing.
# GITHUB_TOKEN=replace-with-your-github-intake-token
# triage, vulncheck, censys_c2, shadowserver: keys are in enrichment above.
# anyrun:
# ANYRUN_API_KEY=replace-with-your-anyrun-api-key
# opencti: requires both your instance URL and token.
# OPENCTI_URL=https://opencti.example
# OPENCTI_TOKEN=replace-with-your-opencti-token
# certstream: public stream endpoint, with your brands/keywords for filtering.
# HECATE_RUNNER_CERTSTREAM_URL=wss://certstream.calidog.io/
# HECATE_RUNNER_CERTSTREAM_BRANDS=your-brand
# HECATE_RUNNER_CERTSTREAM_KEYWORDS=your-keyword

# --- GitHub planning-hunt publication (opt-in) -------------------------------
# Publishes each completed planning hunt as an isolated PR to a policy-approved
# repository. Uses a GitHub App installation token, separate
# from GITHUB_TOKEN above (which is only for CTI search rate limits).
# The App should be installed on the destination with Contents: Read/Write
# and Pull requests: Read/Write. Enable auto-merge and protect `main` with the
# required `content-validation` and `promotion-policy` checks.
# Store the PEM in a mounted secret file (0600), never inline it in this file.
# HECATE_RUNNER_GITHUB_PUBLISHING_ENABLED=true
# HECATE_RUNNER_GITHUB_APP_ID=replace-with-your-github-app-id
# HECATE_RUNNER_GITHUB_INSTALLATION_ID=replace-with-your-installation-id
# HECATE_RUNNER_GITHUB_APP_SLUG=hecate-publisher
# HECATE_RUNNER_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/hecate-publisher.pem
# HECATE_RUNNER_GITHUB_PUBLISHING_REPOSITORY=your-org/your-content-repo
# HECATE_RUNNER_GITHUB_PUBLISHING_BASE_BRANCH=main
# To publish from a different local workspace, use the destination policy and
# a NEW queue path so private backlog is not replayed into the new repository.
# HECATE_RUNNER_GITHUB_PUBLISHING_POLICY_PATH=/absolute/path/to/Hecate-Public/promotion-policy.yaml
# HECATE_RUNNER_GITHUB_PUBLISHING_OUTBOX_PATH=/absolute/path/to/workspace/.hecate/publisher/public-outbox.sqlite3
# HECATE_RUNNER_GITHUB_POC_MIN_STARS=0
# HECATE_RUNNER_GITHUB_POC_TIMEOUT_SEC=15

# --- MalwareBazaar (Abuse.ch Malware Strains) ------------------------------
# Daily & real-time intake of newly cataloged malware payloads.
# Uses ABUSECH_API_KEY (Auth-Key) if available for full metadata (YARA rules,
# delivery method, ClamAV); falls back to keyless public CSV export if unset.
# Filters for samples with identified signatures (Lumma, AgentTesla, RedLine, etc.).
# HECATE_RUNNER_MALWAREBAZAAR_ONLY_SIGNED=true
# HECATE_RUNNER_MALWAREBAZAAR_TIMEOUT_SEC=15

# --- VX-Underground (Malware Strains & Reverse Engineering) -----------------
# Ingests newly published malware family source code and reverse engineering
# research whitepapers from vxunderground/MalwareSourceCode and VXUG-Papers.
# Free / keyless via public Atom feeds and commit patches with zero rate limits.
# HECATE_RUNNER_VXUNDERGROUND_TIMEOUT_SEC=15

# --- Purple-team replay ---------------------------------------------------
# Replay uses synthetic telemetry. Only simulation is supported; subprocess
# and bwrap are rejected during configuration loading. Use BAS for live runs.
# HECATE_RUNNER_PURPLE_TEAM_VALIDATION_ENABLED=true
# HECATE_RUNNER_PURPLE_TEAM_ATOMIC_EMULATION=true # Include Atomic test-derived synthetic telemetry
# HECATE_RUNNER_PURPLE_TEAM_ATOMIC_MODE=simulation

# --- Live Adversary Emulation & Breach Simulation (BAS) --------------------
# Enables Level 4 Purple Teaming validation against MITRE CALDERA and Stratus Red Team.
# HECATE_BAS_ENABLED=false
# HECATE_BAS_AUTO_EXECUTE_LIVE=false          # Opt in only after lab/sensor checks pass
# HECATE_BAS_AUTO_TECHNIQUES=T1033,T1057,T1083 # Choose a subset; ten reviewed Linux procedures available (see docs/BAS_AUTOMATION.md)
# HECATE_BAS_TELEMETRY=none                  # Use lab_process for independent lab observations
# HECATE_BAS_SENSOR_CONTAINER=hecate-bas-agent
# HECATE_BAS_LAB_NETWORK=hecate-bas-lab
# HECATE_BAS_LAB_PAW=hecate-local-sandbox
# HECATE_BAS_AGENT_SERVER_URL=http://caldera:8888
# HECATE_BAS_CALDERA_CONTAINER=caldera
# HECATE_BAS_MODE=mock                        # mock, caldera, stratus; local_sandbox/live_lab alias caldera
# HECATE_BAS_ALLOWED_HOSTS=["lab-host-01"]    # Required whitelist for live CALDERA execution
# HECATE_BAS_ALLOWED_ACCOUNTS=["your-aws-account-id"] # Required for live Stratus cloud execution
# CALDERA_URL=http://localhost:8888
# CALDERA_API_KEY=replace-with-your-caldera-api-key
# CALDERA_AGENT_GROUP=hecate-local-lab        # Must match the sandcat -group on the lab agent
# CALDERA_TIMEOUT_SEC=120
# STRATUS_BINARY_PATH=stratus-red-team
# STRATUS_TIMEOUT_SEC=300



# --- Automatic SIEM drift notifications ---------------------------------------
# Run `hecate-runner maintenance` separately from hunting, or install/start
# hecate-runner-maintenance.service. Hunt cycles only enqueue publication work.
# Each publisher processes one due item per interval; Slack batches contain up to 20 cards.
HECATE_RUNNER_MAINTENANCE_INTERVAL_SEC=60
# Hard deadline per worker process. Tune for large SIEM catalogs; timed-out
# sweeps are retried and do not clear previously observed drift conditions.
HECATE_RUNNER_MAINTENANCE_JOB_TIMEOUT_SEC=900
# Seconds between completed SIEM sweeps (0 disables new audits).
HECATE_RUNNER_SIEM_DRIFT_AUDIT_INTERVAL_SEC=3600
# Unchanged conditions are suppressed across daemon restarts. Changes alert immediately.
# Reminder interval in seconds (default: one day; 0 disables reminders).
HECATE_RUNNER_SIEM_DRIFT_ALERT_REMINDER_SEC=86400

# --- Optional native detection deployment --------------------------------------
# Keep disabled/dry-run until native endpoints, credentials and target permissions
# are verified. Query execution above does not require detection deployment.
HECATE_RUNNER_SIEM_DEPLOY_ENABLED=false
HECATE_RUNNER_SIEM_DEPLOY_DRY_RUN=true
# HECATE_RUNNER_SIEM_DRIFT_AUTO_RECONCILE=false
# Sentinel native saved searches also need these ARM resource coordinates:
# SENTINEL_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# SENTINEL_RESOURCE_GROUP=your-sentinel-resource-group
# Current adapter reuses SENTINEL_WORKSPACE_ID for ARM paths as well as Logs:
# verify workspace resource naming and token audience before enabling deployment.
# Elastic native rules use Kibana's API, whereas EQL queries use Elasticsearch.
# Current native adapter prefers ELASTIC_URL over KIBANA_URL; validate endpoint
# routing before enabling deployment alongside live EQL querying.
# KIBANA_URL=https://kibana.example:5601
# CrowdStrike native deployment uses these separate names (not LOGSCALE_URL/TOKEN):
# FALCON_BASE_URL=https://falcon-api.example
# FALCON_API_TOKEN=replace-with-your-falcon-native-api-token
# Additional native deployment targets (not Runner query-provider options):
# RAPID7_API_KEY=replace-with-your-rapid7-api-key
# RAPID7_REGION=us
# SENTINELONE_URL=https://sentinelone.example
# SENTINELONE_API_TOKEN=replace-with-your-sentinelone-api-token

# Soft fallback to mock synthesis when live BAS cannot run (wrong platform, no
# approved procedure, Caldera down). Does NOT block live approved automation.
# Mock / simulation_match is never credited as bas_verified / bas_live.
# HECATE_BAS_FALLBACK_TO_MOCK=false
