[Unit]
Description=hecate-runner - Hecate resident autonomous daemon
Documentation=https://github.com/Hecate-Org/Hecate-Runner
After=network-online.target ollama.service
Wants=network-online.target hecate-runner-maintenance.service
Requires=ollama.service

[Service]
Type=simple
User=chemch
Group=chemch
WorkingDirectory=/home/chemch/betas/Hecate-Runner

# Read env from the workspace .env (single canonical source of truth), with optional runner-local override.
EnvironmentFile=-/home/chemch/betas/Hecate-Workspace/.env
EnvironmentFile=-/home/chemch/betas/Hecate-Public/.env
EnvironmentFile=-/home/chemch/betas/Hecate-Runner/.env

# Run via uv so we always execute inside the project venv.
ExecStart=/home/chemch/.local/bin/uv run hecate-runner daemon
Restart=always
RestartSec=10s

StandardOutput=append:/home/chemch/betas/Hecate-Core/logs/orchestrator.log
StandardError=append:/home/chemch/betas/Hecate-Core/logs/orchestrator.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/chemch/betas/Hecate-Core /home/chemch/betas/Hecate-Runner /home/chemch/betas/Hecate-Workspace
ReadWritePaths=-/home/chemch/betas/Hecate-Public

[Install]
WantedBy=multi-user.target
