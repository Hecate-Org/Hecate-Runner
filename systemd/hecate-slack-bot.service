[Unit]
Description=Hecate isolated Slack operations service
After=network-online.target hecate-bas-broker.service
Wants=network-online.target hecate-bas-broker.service

[Service]
Type=exec
User=hecate-slack
Group=hecate-slack
SupplementaryGroups=hecate-data
WorkingDirectory=/opt/hecate/runtime
EnvironmentFile=/etc/hecate/slack.env
ExecStart=/opt/hecate/runtime/venv/bin/python -I -m hecate_runner slack-bot
NoNewPrivileges=true
UMask=0007
LimitCORE=0
MemoryMax=4G
TasksMax=256
CPUQuota=200%
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/run/lxd -/var/snap/lxd -/var/lib/lxd -/run/docker.sock -/var/run/docker.sock
ReadOnlyPaths=/opt/hecate
ReadWritePaths=/var/lib/hecate/workspace /var/lib/hecate/homes/slack
NoExecPaths=/var/lib/hecate/workspace
Environment=HECATE_SERVICE_ISOLATED=1
Environment=PYTHON_DOTENV_DISABLED=1
Environment=HECATE_STRICT_CREDENTIAL_ROLES=1
Environment=HECATE_ALLOW_UNSANDBOXED_EMULATION=0
Environment=HECATE_WORKSPACE=/var/lib/hecate/workspace
Environment=HECATE_BAS_BROKER_SOCKET=/run/hecate-bas/broker.sock
Environment=HECATE_BIN=/opt/hecate/runtime/venv/bin/hecate-agent
Environment=PATH=/opt/hecate/runtime/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/hecate/homes/slack
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=control-group

[Install]
WantedBy=multi-user.target
